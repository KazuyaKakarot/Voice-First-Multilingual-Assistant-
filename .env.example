# Copy to .env and fill in.

# ---- LLM: any OpenAI-compatible provider -------------------------------------
# Groq (free tier): https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_key_here
LLM_MODEL=llama-3.3-70b-versatile
# Vision model, used only when the user uploads an image
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Model that grades answers during evaluation (leave empty to reuse LLM_MODEL; a different model is better)
JUDGE_MODEL=

# Gemini (free tier) alternative: https://aistudio.google.com
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your_key_here
# LLM_MODEL=gemini-2.0-flash
# VISION_MODEL=gemini-2.0-flash

# ---- Bhashini (optional: without these the app runs text-only, English) -------
# Register at https://bhashini.gov.in/ulca to get a user ID and ULCA API key.
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
# Pipeline ID from Bhashini's Pipeline Search call / ULCA (see their docs)
BHASHINI_PIPELINE_ID=
